# Core runtime
NODE_ENV="development"
PORT="3000"
# Development/tests only. Production uses Neon via DATABASE_URL.
MATABLE_DB_PATH="./data/matable.db"
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
APP_URL="https://example.com"
TRUST_PROXY_HOPS="0"
DEMO_MODE="false"
# Set MERCHANT_KYC_MODE=didit only when intentionally testing or enabling Didit.
MERCHANT_KYC_MODE="disabled"
DIDIT_ENVIRONMENT="sandbox"
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_WEBHOOK_SECRET=""

# Admin access protection
ADMIN_ACCESS_KEY=""

# Payment / external integrations are intentionally disabled by default.
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
PAYSTACK_CURRENCY="XOF"
PAYSTACK_MOCK_MODE="false"

# WhatsApp / notifications are intentionally disabled by default.
PAYMENT_CONTACT_PHONE="+2250700000000"
WHATSAPP_ADMIN_PHONE="+2250700000000"
WHATSAPP_CLOUD_ENABLED="false"
WHATSAPP_CLOUD_API_VERSION="v21.0"
WHATSAPP_CLOUD_ORDER_TEMPLATE_NAME=""
WHATSAPP_CLOUD_ORDER_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_ACCESS_TOKEN=""

# Optional public hosting / reverse-proxy hints
# Use the public-facing URL, not the internal local URL.
# Example: https://matable-ci.example.com

# Core runtime
NODE_ENV="development"
PORT="3000"
# Development/tests only. Production uses Neon via DATABASE_URL.
MATABLE_DB_PATH="./data/matable.db"
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
APP_URL="https://example.com"
TRUST_PROXY_HOPS="0"
DEMO_MODE="false"
# Admin access protection
ADMIN_ACCESS_KEY=""
# Clé distincte (32+ caractères) pour le rôle vérification/modération
VERIFICATION_ADMIN_ACCESS_KEY=""
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_WEBHOOK_SECRET=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:assistance@matable.ci"

# Connexion sociale client (facultative; secrets serveur uniquement)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APPLE_SERVICE_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

VITE_WHATSAPP_ADMIN_PHONE=""
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Approved Meta utility template with two body placeholders: shop name and expiry date.
WHATSAPP_SUBSCRIPTION_REMINDER_TEMPLATE=""
WHATSAPP_GRAPH_API_VERSION=""
WHATSAPP_TEMPLATE_LANGUAGE="fr"

# E-mails transactionnels (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MaTable.ci <welcome@exemple.com>"
EMAIL_FROM="MaTable.ci <welcome@exemple.com>"

GENIUSPAY_API_KEY=""
GENIUSPAY_API_SECRET=""
GENIUSPAY_WEBHOOK_SECRET=""
GENIUSPAY_API_URL="https://geniuspay.ci/api/v1/merchant/payments"

# Optional public hosting / reverse-proxy hints
# Use the public-facing URL, not the internal local URL.
# Example: https://matable-ci.example.com

# Core runtime
NODE_ENV="development"
PORT="3000"
# Development/tests only. Production uses Neon via DATABASE_URL.
MATABLE_DB_PATH="./data/matable.db"
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
APP_URL="https://example.com"
TRUST_PROXY_HOPS="0"
DEMO_MODE="false"
# Admin access protection
ADMIN_ACCESS_KEY=""
KYC_ENCRYPTION_KEY=""

# Connexion sociale client (facultative; secrets serveur uniquement)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APPLE_SERVICE_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

PAYMENT_CONTACT_PHONE="+2250700000000"
WHATSAPP_ADMIN_PHONE="+2250700000000"

# Optional public hosting / reverse-proxy hints
# Use the public-facing URL, not the internal local URL.
# Example: https://matable-ci.example.com

NODE_ENV=production
PORT=3000
APP_URL=https://votre-domaine.com
DEMO_MODE=false
# Use a dedicated production database URL; staging/tests must use a different database.
DATABASE_URL=postgresql://<utilisateur>:<mot-de-passe>@<hote>/<base>?sslmode=require
PG_POOL_MAX=10
TRUST_PROXY_HOPS=1

ADMIN_ACCESS_KEY=<GENERER_UNE_CLE_DE_32_CARACTERES_MINIMUM>
VERIFICATION_ADMIN_ACCESS_KEY=<GENERER_UNE_AUTRE_CLE_DE_32_CARACTERES_MINIMUM>
AD_EVENT_SIGNING_SECRET=<GENERER_UNE_CLE_DE_32_CARACTERES_MINIMUM>
ADVERTISING_BETA_ENABLED=false

# Vérification d’identité Didit
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_DRIVER_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# Connexion sociale client (facultative)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

VITE_WHATSAPP_ADMIN_PHONE=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SUBSCRIPTION_REMINDER_TEMPLATE=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Notifications Push navigateur
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:assistance@matable.ci

# E-mails transactionnels (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=MaTable.ci <assistance@matable.ci>
EMAIL_FROM=

# Paiements GeniusPay
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_API_URL=https://geniuspay.ci/api/v1/merchant/payments

# Livraison : activer seulement après application des migrations 036 à 042.
DELIVERY_OPERATIONS_ENABLED=false
DELIVERY_SANDBOX_PAYMENTS=false
DELIVERY_REQUIRE_PROOF=true
DELIVERY_OFFER_TTL_MINUTES=120

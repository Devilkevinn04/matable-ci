{
  "name": "matable-ci",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:gateway": "node services/api-gateway/src/server.mjs",
    "build": "vite build && mkdir -p build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "clean": "rm -rf dist build server.js",
    "archive:release": "python3 scripts/create-release-archive.py",
    "repair:order-shops": "node --import dotenv/config --import tsx scripts/repair-order-shop-attribution.ts",
    "test:postgres": "node scripts/run-postgres-tests.mjs",
    "lint": "tsc --noEmit",
    "migrate:neon": "node --import dotenv/config --import tsx scripts/migrate-neon.ts",
    "test": "node --import tsx --test tests/*.test.ts services/api-gateway/test/*.test.mjs",
    "test:gateway": "node --test services/api-gateway/test/*.test.mjs",
    "lint:gateway": "node --check services/api-gateway/src/server.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tesseract.js-data/fra": "^1.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^3.0.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
